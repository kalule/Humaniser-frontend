Id&quot;:&quot;8d8c5542-a8d2-b422-a385-0d2006c0bf96&quot;,&quot;openAlexWorkId&quot;:&quot;W3203342489&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W3203342489&quot;,&quot;title&quot;:&quot;Impact of smartphone usage on academic performance: a study on undergraduates in FMSC of University of Sri Jayewardenepura, Sri Lanka&quot;,&quot;url&quot;:&quot;https://doi.org/10.4038/jm.v15i1.7593&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.4038/jm.v15i1.7593&quot;,&quot;authors&quot;:&quot;Nirmal Chathuranga, J. M. D. P. Jaysundara&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Chathuranga&quot;,&quot;given&quot;:&quot;Nirmal&quot;,&quot;name&quot;:&quot;Nirmal Chathuranga&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0001-9263-9239&quot;,&quot;affiliations&quot;:[&quot;University of Sri Jayewardenepura&quot;]},{&quot;family&quot;:&quot;Jaysundara&quot;,&quot;given&quot;:&quot;J. M. D. P.&quot;,&quot;name&quot;:&quot;J. M. D. P. Jaysundara&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Sri Jayewardenepura&quot;]}],&quot;year&quot;:2020,&quot;venue&quot;:&quot;Journal of Management&quot;,&quot;volume&quot;:&quot;15&quot;,&quot;issue&quot;:&quot;1&quot;,&quot;pages&quot;:&quot;14&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S19&quot;},&quot;originalLabel&quot;:&quot;[S19]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S22&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S22&quot;,&quot;canonicalId&quot;:&quot;b7f8d5e6-4813-3198-4099-2f6203e3cbc8&quot;,&quot;openAlexWorkId&quot;:&quot;W7214813884&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7214813884&quot;,&quot;title&quot;:&quot;SOCIAL NETWORKING USAGE AND ACADEMIC PERFORMANCE OF SCHOOL-GOING ADOLESCENTS IN OYO CITY, NIGERIA&quot;,&quot;url&quot;:&quot;https://tijseg.org/index.php/tijseg/article/download/109/146&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Fatimah Wuraola Garba&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Garba&quot;,&quot;given&quot;:&quot;Fatimah Wuraola&quot;,&quot;name&quot;:&quot;Fatimah Wuraola Garba&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Abuja&quot;]}],&quot;year&quot;:2022,&quot;venue&quot;:&quot;Turkish International Journal of Special Education and Guidance &amp; Counselling (TIJSEG)&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S22&quot;},&quot;originalLabel&quot;:&quot;[S22]&quot;}]" data-narrative="false">(Khan, Khalid and Iqbal, 2019; Chathuranga and Jaysundara, 2020; Garba, 2022; Ciroma, Abubakar and Bashir, 2025; Duc, 2025; Hajar et al., 2025; Sadia, Babar and Ghaffar, 2025; Sari et al., 2025; Ajubiga et al., 2026; Chaudhary, 2026; OMI UJUANBI and Omolegho, 2026; European Journal of Integrative Medicinal and Allied Paramedical Spectrum Studies, 2026)</cite>. For example, higher social media overuse has been linked to increased psychological distress and a deterioration in academic performance <cite data-citation-id="" data-occurrence-id="ab438447-eda5-40fc-a695-1e47d0019968" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S15&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S15&quot;,&quot;canonicalId&quot;:&quot;709df0c1-a94e-2623-9c06-ec42b7fd7158&quot;,&quot;openAlexWorkId&quot;:&quot;W7117361642&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7117361642&quot;,&quot;title&quot;:&quot;Excessive social media use and its impact on psychological well-being and academic performance of Vietnamese university students&quot;,&quot;url&quot;:&quot;https://doi.org/10.1080/02673843.2025.2608766&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.1080/02673843.2025.2608766&quot;,&quot;authors&quot;:&quot;Tran Minh Duc&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Duc&quot;,&quot;given&quot;:&quot;Tran Minh&quot;,&quot;name&quot;:&quot;Tran Minh Duc&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Thu Dau Mot University&quot;]}],&quot;year&quot;:2025,&quot;venue&quot;:&quot;International Journal of Adolescence and Youth&quot;,&quot;volume&quot;:&quot;31&quot;,&quot;issue&quot;:&quot;1&quot;,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Taylor &amp; Francis&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S15&quot;},&quot;originalLabel&quot;:&quot;[S15]&quot;}]" data-narrative="false">(Duc, 2025)</cite>. Daily social media hours often have a significant negative effect on students' Grade Point Averages (GPAs) <cite data-citation-id="" data-occurrence-id="a7fdbe05-ce72-47ff-bbfb-cbc75eba6c11" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S4&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S4&quot;,&quot;canonicalId&quot;:&quot;4286b9f9-2462-9531-fc7d-9ff6094dcb6c&quot;,&quot;openAlexWorkId&quot;:&quot;W7164532107&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7164532107&quot;,&quot;title&quot;:&quot;The Influence of Social Media Usage on Students&#39; Academic Performance and Study Habits&quot;,&quot;url&quot;:&quot;https://doi.org/10.5281/zenodo.20669918&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.5281/zenodo.20669918&quot;,&quot;authors&quot;:&quot;Saroj Chaudhary&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Chaudhary&quot;,&quot;given&quot;:&quot;Saroj&quot;,&quot;name&quot;:&quot;Saroj Chaudhary&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]}],&quot;year&quot;:2026,&quot;venue&quot;:&quot;Zenodo (CERN European Organization for Nuclear Research)&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;European Organization for Nuclear Research&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S4&quot;},&quot;originalLabel&quot;:&quot;[S4]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S5&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S5&quot;,&quot;canonicalId&quot;:&quot;40107c2c-646d-7872-050b-107a4a66b1e9&quot;,&quot;openAlexWorkId&quot;:&quot;W2992858501&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W2992858501&quot;,&quot;title&quot;:&quot;Revealing the Relationship between Smartphone Addiction and Academic Performance of Students: Evidences from Higher Educational Institutes of Pakistan&quot;,&quot;url&quot;:&quot;https://openalex.org/W2992858501&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Arooba Azam Khan, Asma Khalid, Rimsha Iqbal&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Khan&quot;,&quot;given&quot;:&quot;Arooba Azam&quot;,&quot;name&quot;:&quot;Arooba Azam Khan&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quo