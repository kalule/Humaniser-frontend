ional University of Malaysia&quot;]},{&quot;family&quot;:&quot;Daud&quot;,&quot;given&quot;:&quot;Muhammad Zaid&quot;,&quot;name&quot;:&quot;Muhammad Zaid Daud&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-4394-5181&quot;,&quot;affiliations&quot;:[&quot;National University of Malaysia&quot;]},{&quot;family&quot;:&quot;Alswat&quot;,&quot;given&quot;:&quot;Haitham M.&quot;,&quot;name&quot;:&quot;Haitham M. Alswat&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0001-5032-9259&quot;,&quot;affiliations&quot;:[&quot;Shaqra University&quot;]}],&quot;year&quot;:2024,&quot;venue&quot;:&quot;Multidisciplinary Reviews&quot;,&quot;volume&quot;:&quot;8&quot;,&quot;issue&quot;:&quot;5&quot;,&quot;pages&quot;:&quot;2025142&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S10&quot;},&quot;originalLabel&quot;:&quot;[S10]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S13&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S13&quot;,&quot;canonicalId&quot;:&quot;35af1ecd-c552-446e-9486-334fa2d31122&quot;,&quot;openAlexWorkId&quot;:&quot;W4414553366&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W4414553366&quot;,&quot;title&quot;:&quot;Patterns, Perceptions, and Academic Implications of Social Media Use among Tertiary Institution Students in Yobe State, Nigeria&quot;,&quot;url&quot;:&quot;https://ejournal.yasin-alsys.org/AMJSAI/article/download/7482/5600&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.58578/amjsai.v2i3.7482&quot;,&quot;authors&quot;:&quot;Zainab Ibrahim Ciroma, Abdulkadir Musa Abubakar, Abdulkarim Bello Bashir&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Ciroma&quot;,&quot;given&quot;:&quot;Zainab Ibrahim&quot;,&quo