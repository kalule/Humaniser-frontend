.2026.v6.i2.99131&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.66572/ejimapss.2026.v6.i2.99131&quot;,&quot;authors&quot;:null,&quot;authorDetails&quot;:[],&quot;year&quot;:2026,&quot;venue&quot;:&quot;European Journal of Integrative Medicinal and Allied Paramedical Spectrum Studies&quot;,&quot;volume&quot;:&quot;6&quot;,&quot;issue&quot;:&quot;2&quot;,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S14&quot;},&quot;originalLabel&quot;:&quot;[S14]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S17&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S17&quot;,&quot;canonicalId&quot;:&quot;ee8ba2a6-8919-289d-c6c6-db153a2a7a3d&quot;,&quot;openAlexWorkId&quot;:&quot;W7112829116&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7112829116&quot;,&quot;title&quot;:&quot;The influence of TikTok on academic performance among university students at UiTM Alor Gajah, Melaka&quot;,&quot;url&quot;:&quot;https://ir.uitm.edu.my/id/eprint/123523/1/123523.pdf&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Mat Said, Siti Hajar, Ahmad Hisham, Widad Nasuha, Hussar, Adlyn Nazurah, Anuar, Nur Ellesya Balqis, Sarudin, Muhammad Faizi, Sah Allam, Siti Nurshahidah, Hassan, Mohd Sufiean&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Hajar&quot;,&quot;given&quot;:&quot;Siti Hajar&quot;,&quot;name&quot;:&quot;Mat Said, Siti Hajar&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Nasuha&quot;,&quot;given&quot;:&quot;Widad Nasuha&quot;,&quot;name&quot;:&quot;Ahmad Hisham, Widad Nasuha&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Hussar&quot;,&quot;given&quot;:&quot;Adlyn Nazurah&quot;,&quot;name&quot;:&quot;Hussar, Adlyn Nazurah&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Anuar&quot;,&quot;given&quot;:&quot;Nur Ellesya Balqis&quot;,&quot;name&quot;:&quot;Anuar, Nur Ellesya Balqis&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Sarudin&quot;,&quot;given&quot;:&quot;Muhammad Faizi&quot;,&quot;name&quot;:&quot;Sarudin, Muhammad Faizi&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Nurshahidah&quot;,&quot;given&quot;:&quot;Siti Nurshahidah&quot;,&quot;name&quot;:&quot;Sah Allam, Siti Nurshahidah&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Hassan&quot;,&quot;given&quot;:&quot;Mohd Sufiean&quot;,&quot;name&quot;:&quot;Hassan, Mohd Sufiean&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]}],&quot;year&quot;:2025,&quot;venue&quot;:&quot;UiTM Institutional Repositories (Universiti Teknologi MARA)&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Universiti Teknologi MARA&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S17&quot;},&quot;originalLabel&quot;:&quot;[S17]&quot;}]" data-narrative="false">(Khan, Khalid and Iqbal, 2019; Ciroma, Abubakar and Bashir, 2025; Hajar et al., 2025; Joshi and Singh, 2025; Sadia, Babar and Ghaffar, 2025; Chaudhary, 2026; OMI UJUANBI and Omolegho, 2026; European Journal of Integrative Medicinal and Allied Paramedical Spectrum Studies, 2026)</cite>.</p><p>Numerous studies have explored the impact of social media on academic outcomes, often revealing a nuanced relationship. Research consistently indicates that excessive and non-academic social media use can lead to decreased concentration, poor time management, reduced study efficiency, and lower academic achievement <cite data-citation-id="" data-occurrence-id="7a5918e5-fc2c-4048-86ea-4373ddf2ee3c" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S1&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S1&quot;,&quot;canonicalId&quot;:&quot;50c0f715-5ed4-66e3-96d9-0b8fb9aa09d6&quot;,&quot;openAlexWorkId&quot;:&quot;W7168081275&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7168081275&quot;,&quot;title&quot;:&quot;Time Spent on Social Media and its Impact on Academic Performance: Evidence from University Students in Sargodha, Pakistan&quot;,&quot;url&quot;:&quot;https://ojs.pssr.org.pk/journal/article/download/1159/947&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.35484/pssr.2025(9-iv)22&quot;,&quot;authors&quot;:&quot;Halema Sadia, Muhammad Hassan Babar, Zunaira Ghaffar&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Sadia&quot;,&quot;given&quot;:&quot;Halema&quot;,&quot;name&quot;:&quot;Halema Sadia&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0009-0008-4477-3319&quot;,&quot;affiliations&quot;:[&quot;University of Sargodha&quot;]},{&quot;family&quot;:&quot;Babar&quot;,&quot;given&quot;:&quot;Muhammad Hassan&quot;,&quot;name&quot;:&quot;Muhammad Hassan Babar&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Lahore&quot;]},{&quot;family&quot;:&quot;Ghaffar&quot;,&quot;given&quot;:&quot;Zunaira&quot;,&quot;name&quot;:&quot;Zunaira Ghaffar&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Sargodha&quot;]}],&quot;year&quot;:2025,&quot;venue&quot;:&quot;Pakistan Social Sciences Review&quot;,&quot;volume&quot;:&quot;9&quot;,&quot;issue&quot;:&quot;IV&quot;,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quo