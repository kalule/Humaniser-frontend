quot;venue&quot;:&quot;Zenodo (CERN European Organization for Nuclear Research)&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;European Organization for Nuclear Research&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S4&quot;},&quot;originalLabel&quot;:&quot;[S4]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S5&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S5&quot;,&quot;canonicalId&quot;:&quot;40107c2c-646d-7872-050b-107a4a66b1e9&quot;,&quot;openAlexWorkId&quot;:&quot;W2992858501&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W2992858501&quot;,&quot;title&quot;:&quot;Revealing the Relationship between Smartphone Addiction and Academic Performance of Students: Evidences from Higher Educational Institutes of Pakistan&quot;,&quot;url&quot;:&quot;https://openalex.org/W2992858501&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Arooba Azam Khan, Asma Khalid, Rimsha Iqbal&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Khan&quot;,&quot;given&quot;:&quot;Arooba Azam&quot;,&quot;name&quot;:&quot;Arooba Azam Khan&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Khalid&quot;,&quot;given&quot;:&quot;Asma&quot;,&quot;name&quot;:&quot;Asma Khalid&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-3919-2487&quot;,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Iqbal&quot;,&quot;given&quot;:&quot;Rimsha&quot;,&quot;name&quot;:&quot;Rimsha Iqbal&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-4685-2834&quot;,&quot;affiliations&quot;:[]}],&quot;year&quot;:2019,&quot;venue&quot;:&quot;Social Science Open Access Repository (GESIS – Leibniz Institute for the Social Sciences)&quot;,&quot;volume&quot;:&quot;3&quot;,&quot;issue&quot;:&quot;2&quot;,&quot;pages&quot;:&quot;74-83&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;GESIS - Leibniz Institute for the Social Sciences&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S5&quot;},&quot;originalLabel&quot;:&quot;[S5]&quot;}]" data-narrative="false">(Khan, Khalid and Iqbal, 2019; Tauheed et al., 2025; Chaudhary, 2026)</cite>, a comprehensive exploration of its specific pathways in the social media-academic performance relationship is still developing. Furthermore, studies often focus on specific platforms <cite data-citation-id="" data-occurrence-id="bdaa6f2f-d992-4a84-90d1-16ee254d3bfb" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S17&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S17&quot;,&quot;canonicalId&quot;:&quot;ee8ba2a6-8919-289d-c6c6-db153a2a7a3d&quot;,&quot;openAlexWorkId&quot;:&quot;W7112829116&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7112829116&quot;,&quot;title&quot;:&quot;The influence of TikTok on academic performance among university students at UiTM Alor Gajah, Melaka&quot;,&quot;url&quot;:&quot;https://ir.uitm.edu.my/id/eprint/123523/1/123523.pdf&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Mat Said, Siti Hajar, Ahmad Hisham, Widad Nasuha, Hussar, Adlyn Nazurah, Anuar, Nur Ellesya Balqis, Sarudin, Muhammad Faizi, Sah Allam, Siti Nurshahidah, Hassan, Mohd Sufiean&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Hajar&quot;,&quot;given&quot;:&quot;Siti Hajar&quot;,&quot;name&quot;:&quot;Mat Said, Siti Hajar&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Nasuha&quot;,&quot;given&quot;:&quot;Widad Nasuha&quot;,&quot;name&quot;:&quot;Ahmad Hisham, Widad Nasuha&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Hussar&quot;,&quot;given&quot;:&quot;Adlyn Nazurah&quot;,&quot;name&quot;:&quot;Hussar, Adlyn Nazurah&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Anuar&quot;,&quot;given&quot;:&quot;Nur Ellesya Balqis&quot;,&quot;name&quot;:&quot;Anuar, Nur Ellesya Balqis&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Sarudin&quot;,&quot;given&quot;:&quot;Muhammad Faizi&quot;,&quot;name&quot;:&quot;Sarudin, Muhammad Faizi&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Nurshahidah&quot;,&quot;given&quot;:&quot;Siti Nurshahidah&quot;,&quot;name&quot;:&quot;Sah Allam, Siti Nurshahidah&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Hassan&quot;,&quot;given&quot;:&quot;Mohd Sufiean&quot;,&quot;name&quot;:&quot;Hassan, Mohd Sufiean&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]}],&quot;year&quot;:2025,&quot;venue&quot;:&quot;UiTM Institutional Repositories (Universiti Teknologi MARA)&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Universiti Teknologi MARA&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S17&quot;},&quot;originalLabel&quot;:&quot;[S17]&quot;}]" data-narrative="false">(Hajar et al., 2025)</cite> or contexts, such as social media addiction <cite data-citation-id="" data-occurrence-id="10ae52f9-9f49-4d54-900e-65b5be1079e6" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S9&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S9&quot;,&quot;canonicalId&quot;:&quot;10cf1867-0020-fae6-1342-ab8dce07fad9&quot;,&quot;openAlexWorkId&quot;:&quot;W4411204892&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W4411204892&quot;,&quot;title&quot;:&quot;Social Media Addiction and Academic Performance of University Students&quot;,&quot;url&quot;:&quot;http://uijournal.usim.edu.my/index.php/uij/article/download/476/305&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.33102/uij.vol34no2.476&quot;,&quot;authors&quot;:&quot;Fatin Najihah Basri, Farhana Sabri, Mohd Khairul Anuar Rahimi&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Basri&quot;,&quot;given&quot;:&quot;Fatin Najihah&quot;,&quot;name&quot;:&quot;Fatin Najihah Basri&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Universiti Sains Islam Malaysia&quot;]},{&quot;family&quot;:&quot;Sabri&quot;,&quot;given&quot;:&quot;Farhana&quot;,&quot;name&quot;:&quot;Farhana Sabri&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-3177-3084&quot;,&quot;affiliations&quot;:[&quot;Universiti Sains Islam Malaysia&quot;]},{&quot;family&quot;:&quot;Rahimi&quot;,&quot;given&quot;:&quot;Mohd Khairul Anuar&quot;,&quot;name&quot;:&quot;Mohd Khairul Anuar Rahimi&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Universiti Sains Islam Malaysia&quot;]}],&quot;year&quot;:2022,&quot;venue&quot;:&quot;Ulum Islamiyyah&quot;,&quot;volume&quot;:&quot;34&quot;,&quot;issue&quot;:&quot;2&quot;,&quot;pages&quot;:&quot;1-17&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Universiti Sains Islam Malaysia&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S9&quot;},&quot;originalLabel&quot;:&quot;[S9]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S15&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S15&quot;,&quot;canonicalId&quot;:&quot;709df0c1-a94e-2623-9c06-ec42b7fd7158&quot;,&quot;openAlexWorkId&quot;:&quot;W7117361642&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7117361642&quot;,&quot;title&quot;:&quot;Excessive social media use and its impact on psychological well-being and academic performance of Vietnamese university students&quot;,&quot;url&quot;:&quot;https://doi.org/10.1080/02673843.2025.2608766&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.1080/02673843.2025.2608766&quot;,&quot;authors&quot;:&quot;Tran Minh Duc&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Duc&quot;,&quot;given&quot;:&quot;Tran Minh&quot;,&quot;name&quot;:&quot;Tran Minh Duc&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Thu Dau Mot University&quot;]}],&quot;year&quot;:2025,&quot;venue&quot;:&quot;International Journal of Adolescence and Youth&quot;,&quot;volume&quot;:&quot;31&quot;,&quot;issue&quot;:&quot;1&quot;,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Taylor &amp; Francis&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S15&quot;},&quot;originalLabel&quot;:&quot;[S15]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S20&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S20&quot;,&quot;canonicalId&quot;:&quot;72052be1-1693-9573-3fc3-1b3516addd04&quot;,&quot;openAlexWorkId&quot;:&quot;W2800281014&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W2800281014&quot;,&quot;title&quot;:&quot;SOCIAL MEDIA ADDICTION AND ACADEMIC ENGAGEMENT AMONG UNDERGRADUATE STUDENTS OF USMANU DANFODIYO UNIVERSITY SOKOTO, NIGERIA&quot;,&quot;url&quot;:&quot;https://ijitie.aitie.org.ng/index.php/ijitie/article/download/55/30&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Zubairu Suleiman&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Suleiman&quot;,&quot;given&quot;:&quot;Zubairu&quot;,&quot;name&quot;:&quot;Zubairu Suleiman&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Gombe State University&quot;]}],&quot;year&quot;:2017,&quot;venue&quot;:&quot;International Journal of Innovative Technology Integration in Education&quot;,&quot;volume&quot;:&quot;1&quot;,&quot;issue&quot;:&quot;2&quot;,&quot;pages&quot;:&quot;39-46&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S20&quot;},&quot;originalLabel&quot;:&quot;[S20]&quot;}]" data-narrative="false">(Suleiman, 2017; Basri, Sabri and Rahimi, 2022; Duc, 2025)</cite>, rather than a holistic view. There is also limited research from the Global South, with most studies originating from the United States and the United Kingdom <cite data-citation-id="" data-occurrence-id="f82d7a07-03b7-4a68-90fd-4d421c18caea" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S29&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S29&quot;,&quot;canonicalId&quot;:&quot;9f8f1ffc-3fb5-3947-632b-f570e397b7fd&quot;,&quot;openAlexWorkId&quot;:&quot;W3014646985&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W3014646985&quot;,&quot;title&quot;:&quot;Mapping research in student engagement and educational technology in higher education: a systematic evidence map&quot;,&quot;url&quot;:&quot;https://doi.org/10.1186/s41239-019-0176-8&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.1186/s41239-019-0176-8&quot;,&quot;authors&quot;:&quot;Melissa Bond, Katja Buntins, Svenja Bedenlier, Olaf Zawacki‐Richter, Michael Kerres&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Bond&quot;,&quot;given&quot;:&quot;Melissa&quot;,&quot;name&quot;:&quot;Melissa Bond&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-8267-031X&quot;,&quot;affiliations&quot;:[&quot;Carl von Ossietzky Universität Oldenburg&quot;]},{&quot;family&quot;:&quot;Buntins&quot;,&quot;given&quot;:&quot;Katja&quot;,&quot;name&quot;:&quot;Katja Buntins&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0001-5571-6952&quot;,&quot;affiliations&quot;:[&quot;University of Duisburg-Essen&quot;]},{&quot;family&quot;:&quot;Bedenlier&quot;,&quot;given&quot;:&quot;Svenja&quot;,&quot;name&quot;:&quot;Svenja Bedenlier&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-7940-5232&quot;,&quot;affiliations&quot;:[&quot;Carl von Ossietzky Universität Oldenburg&quot;]},{&quot;family&quot;:&quot;Zawacki-Richter&quot;,&quot;given&quot;:null,&quot;name&quot;:&quot;Olaf Zawacki‐Richter&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-1482-8303&quot;,&quot;affiliations&quot;:[&quot;Carl von Ossietzky Universität Oldenburg&quot;]},{&quot;family&quot;:&quot;Kerres&quot;,&quot;given&quot;:&quot;Michael&quot;,&quot;name&quot;:&quot;Michael Kerres&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-7419-3023&quot;,&quot;affiliations&quot;:[&quot;University of Duisburg-Essen&quot;]}],&quot;year&quot;:2020,&quot;venue&quot;:&quot;International Journal of Educational Technology in Higher Education&quot;,&quot;volume&quot;:&quot;17&quot;,&quot;issue&quot;:&quot;1&quot;,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Springer Nature&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S29&quot;},&quot;originalLabel&quot;:&quot;[S29]&quot;}]" data-narrative="false">(Bond et al., 2020)</cite>, which may limit the generalizability of findings across diverse educational systems and student populations. The absence of longitudinal designs in much of the existing quantitative research also restricts the ability to infer causal relationships between variables <cite data-citation-id="" data-occurrence-id="2c7d6649-bd15-41c7-ad43-2b8c8977326a" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S11&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S11&quot;,&quot;canonicalId&quot;:&quot;2490620b-0319-3d39-1157-60d154812034&quot;,&quot;openAlexWorkId&quot;:&quot;W2994935786&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W2994935786&quot;,&quot;title&quot;:&quot;Social media and student performance: the moderating role of ICT knowledge&quot;,&quot;url&quot;:&quot;https://doi.org/10.1108/jices-08-2019-0092&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.1108/jices-08-2019-0092&quot;,&quot;authors&quot;:&quot;Robert Kwame Dzogbenuku, George Kofi Amoako, Desmond Kwadjo Kumi&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Dzogbenuku&quot;,&quot;given&quot;:&quot;Robert Kwame&quot;,&quot;name&quot;:&quot;Robert Kwame Dzogbenuku&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-6290-8458&quot;,&quot;affiliations&quot;:[&quot;Central University&quot;]},{&quot;family&quot;:&quot;Amoako&quot;,&quot;given&quot;:&quot;George Kofi&quot;,&quot;name&quot;:&quot;George Kofi Amoako&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-7966-4867&quot;,&quot;affiliations&quot;:[&quot;Central University&quot;]},{&quot;family&quot;:&quot;Kumi&quot;,&quot;given&quot;:&quot;Desmond Kwadjo&quot;,&quot;name&quot;:&quot;Desmond Kwadjo Kumi&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-5737-4965&quot;,&quot;affiliations&quot;:[]}],&quot;year&quot;:2019,&quot;venue&quot;:&quot;Journal of Information Communication and Ethics in Society&quot;,&quot;volume&quot;:&quot;18&quot;,&quot;issue&quot;:&quot;2&quot;,&quot;pages&quot;:&quot;197-219&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Emerald Publishing Limited&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S11&quot;},&quot;originalLabel&quot;:&quot;[S11]&quot;}]" data-narrative="false">(Dzogbenuku, Amoako and Kumi, 2019)</cite>.</p><h2>Research Gaps</h2><p>Despite the extensive literature on social media use, time management, and academic performance, several research gaps remain. Many existing studies rely predominantly on self-reported data for social media use and academic performance, which can introduce response biases and limit the objectivity of findings <cite data-citation-id="" data-occurrence-id="d11d6e1e-c33b-4ce8-a936-1b025899d09b" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S15&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S15&quot;,&quot;canonicalId&quot;:&quot;709df0c1-a94e-2623-9c06-ec42b7fd7158&quot;,&quot;openAlexWorkId&quot;:&quot;W7117361642&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7117361642&quot;,&quot;title&quot;:&quot;Excessive social media use and its impact on psychological well-being and academic performance of Vietnamese university students&quot;,&quot;url&quot;:&quot;https://doi.org/10.1080/02673843.2025.2608766&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.1080/02673843.2025.2608766&quot;,&quot;authors&quot;:&quot;Tran Minh Duc&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Duc&quot;,&quot;given&quot;:&quot;Tran Minh&quot;,&quot;name&quot;:&quot;Tran Minh Duc&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Thu Dau Mot University&quot;]}],&quot;year&quot;:2025,&quot;venue&quot;:&quot;International Journal of Adolescence and Youth&quot;,&quot;volume&quot;:&quot;31&quot;,&quot;issue&quot;:&quot;1&quot;,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Taylor &amp; Francis&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S15&quot;},&quot;originalLabel&quot;:&quot;[S15]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S17&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S17&quot;,&quot;canonicalId&quot;:&quot;ee8ba2a6-8919-289d-c6c6-db153a2a7a3d&quot;,&quot;openAlexWorkId&quot;:&quot;W7112829116&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7112829116&quot;,&quot;title&quot;:&quot;The influence of TikTok on academic performance among university students at UiTM Alor Gajah, Melaka&quot;,&quot;url&quot;:&quot;https://ir.uitm.edu.my/id/eprint/123523/1/123523.pdf&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Mat Said, Siti Hajar, Ahmad Hisham, Widad Nasuha, Hussar, Adlyn Nazurah, Anuar, Nur Ellesya Balqis, Sarudin, Muhammad Faizi, Sah Allam, Siti Nurshahidah, Hassan, Mohd Sufiean&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Hajar&quot;,&quot;given&quot;:&quot;Siti Hajar&quot;,&quot;name&quot;:&quot;Mat Said, Siti Hajar&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Nasuha&quot;,&quot;given&quot;:&quot;Widad Nasuha&quot;,&quot;name&quot;:&quot;Ahmad Hisham, Widad Nasuha&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Hussar&quot;,&quot;given&quot;:&quot;Adlyn Nazurah&quot;,&quot;name&quot;:&quot;Hussar, Adlyn Nazurah&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Anuar&quot;,&quot;given&quot;:&quot;Nur Ellesya Balqis&quot;,&quot;name&quot;:&quot;Anuar, Nur Ellesya Balqis&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Sarudin&quot;,&quot;given&quot;:&quot;Muhammad Faizi&quot;,&quot;name&quot;:&quot;Sarudin, Muhammad Faizi&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Nurshahidah&quot;,&quot;given&quot;:&quot;Siti Nurshahidah&quot;,&quot;name&quot;:&quot;Sah Allam, Siti Nurshahidah&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Hassan&quot;,&quot;given&quot;:&quot;Mohd Sufiean&quot;,&quot;name&quot;:&quot;Hassan, Mohd Sufiean&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]}],&quot;year&quot;:2025,&quot;venue&quot;:&quot;UiTM Institutional Repositories (Universiti Teknologi MARA)&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Universiti Teknologi MARA&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S17&quot;},&quot;originalLabel&quot;:&quot;[S17]&quot;}]" data-narrative="false">(Duc, 2025; Hajar et al., 2025)</cite>. Furthermore, a significant portion of research originates from the United States and the United Kingdom, with limited representation from the Global South <cite data-citation-id="" data-occurrence-id="228a4423-0eaf-406c-bf67-7b1fc3650a00" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S29&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S29&quot;,&quot;canonicalId&quot;:&quot;9f8f1ffc-3fb5-3947-632b-f570e397b7fd&quot;,&quot;openAlexWorkId&quot;:&quot;W3014646985&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W3014646985&quot;,&quot;title&quot;:&quot;Mapping research in student engagement and educational technology in higher education: a systematic evidence map&quot;,&quot;url&quot;:&quot;https://doi.org/10.1186/s41239-019-0176-8&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.1186/s41239-019-0176-8&quot;,&quot;authors&quot;:&quot;Melissa Bond, Katja Buntins, Svenja Bedenlier, Olaf Zawacki‐Richter, Michael Kerres&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Bond&quot;,&quot;given&quot;:&quot;Melissa&quot;,&quot;name&quot;:&quot;Melissa Bond&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-8267-031X&quot;,&quot;affiliations&quot;:[&quot;Carl von Ossietzky Universität Oldenburg&quot;]},{&quot;family&quot;:&quot;Buntins&quot;,&quot;given&quot;:&quot;Katja&quot;,&quot;name&quot;:&quot;Katja Buntins&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0001-5571-6952&quot;,&quot;affiliations&quot;:[&quot;University of Duisburg-Essen&quot;]},{&quot;family&quot;:&quot;Bedenlier&quot;,&quot;given&quot;:&quot;Svenja&quot;,&quot;name&quot;:&quot;Svenja Bedenlier&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-7940-5232&quot;,&quot;affiliations&quot;:[&quot;Carl von Ossietzky Universität Oldenburg&quot;]},{&quot;family&quot;:&quot;Zawacki-Richter&quot;,&quot;given&quot;:null,&quot;name&quot;:&quot;Olaf Zawacki‐Richter&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-1482-8303&quot;,&quot;affiliations&quot;:[&quot;Carl von Ossietzky Universität Oldenburg&quot;]},{&quot;family&quot;:&quot;Kerres&quot;,&quot;given&quot;:&quot;Michael&quot;,&quot;name&quot;:&quot;Michael Kerres&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-7419-3023&quot;,&quot;affiliations&quot;:[&quot;University of Duisburg-Essen&quot;]}],&quot;year&quot;:2020,&quot;venue&quot;:&quot;International Journal of Educational Technology in Higher Education&quot;,&quot;volume&quot;:&quot;17&quot;,&quot;issue&quot;:&quot;1&quot;,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Springer Nature&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S29&quot;},&quot;originalLabel&quot;:&quot;[S29]&quot;}]" data-narrative="false">(Bond et al., 2020)</cite>, which restricts the generalizability of conclusions across diverse cultural and educational contexts.</p><p>While some literature acknowledges the role of time management <cite data-citation-id="" data-occurrence-id="7f23b656-2658-4c11-adf0-19b1e2cfd531" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S3&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S3&quot;,&quot;canonicalId&quot;:&quot;b61186cc-2965-3b5d-70e0-de17b70d7e2d&quot;,&quot;openAlexWorkId&quot;:&quot;W7129271745&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7129271745&quot;,&quot;title&quot;:&quot;Productive and Problematic Social Media Use and Students’ Academic Outcomes: Mediation by Parent/Teacher Support and Moderation by Time Management Skills (Evidence from Higher Education Institutions in Punjab and Khyber Pakhtunkhwa, Pakistan)&quot;,&quot;url&quot;:&quot;https://rjsaonline.com/journals/index.php/rjsa/article/download/715/893&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.71317/rjsa.003.06.0715&quot;,&quot;authors&quot;:&quot;Najma Tauheed, Muhammad Aslam Khan, Muhammad Siddique, Hafiz Safi Ullah, Haji Irfan Haider, Mahesh Kumar Oad&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Tauheed&quot;,&quot;given&quot;:&quot;Najma&quot;,&quot;name&quot;:&quot;Najma Tauheed&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Khan&quot;,&quot;given&quot;:&quot;Muhammad Aslam&quot;,&quot;name&quot;:&quot;Muhammad Aslam Khan&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0001-6219-3918&quot;,&quot;affiliations&quot;:[&quot;University of Haripur&quot;]},{&quot;family&quot;:&quot;Siddique&quot;,&quot;given&quot;:&quot;Muhammad&quot;,&quot;name&quot;:&quot;Muhammad Siddique&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Gomal University&quot;]},{&quot;family&quot;:&quot;Ullah&quot;,&quot;given&quot;:&quot;Hafiz Safi&quot;,&quot;name&quot;:&quot;Hafiz Safi Ullah&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Gomal University&quot;]},{&quot;family&quot;:&quot;Haider&quot;,&quot;given&quot;:&quot;Haji Irfan&quot;,&quot;name&quot;:&quot;Haji Irfan Haider&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Gomal University&quot;]},{&quot;family&quot;:&quot;Oad&quot;,&quot;given&quot;:&quot;Mahesh Kumar&quot;,&quot;name&quot;:&quot;Mahesh Kumar Oad&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Sindh&quot;]}],&quot;year&quot;:2025,&quot;venue&quot;:&quot;Research Journal for Social Affairs&quot;,&quot;volume&quot;:&quot;3&quot;,&quot;issue&quot;:&quot;6&quot;,&quot;pages&quot;:&quot;1847-1856&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S3&quot;},&quot;originalLabel&quot;:&quot;[S3]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S4&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S4&quot;,&quot;canonicalId&quot;:&quot;4286b9f9-2462-9531-fc7d-9ff6094dcb6c&quot;,&quot;openAlexWorkId&quot;:&quot;W7164532107&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7164532107&quot;,&quot;title&quot;:&quot;The Influence of Social Media Usage on Students&#39; Academic Performance and Study Habits&quot;,&quot;url&quot;:&quot;https://doi.org/10.5281/zenodo.20669918&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.5281/zenodo.20669918&quot;,&quot;authors&quot;:&quot;Saroj Chaudhary&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Chaudhary&quot;,&quot;given&quot;:&quot;Saroj&quot;,&quot;name&quot;:&quot;Saroj Chaudhary&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]}],&quot;year&quot;:2026,&quot;venue&quot;:&quot;Zenodo (CERN European Organization for Nuclear Research)&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;European Organization for Nuclear Research&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S4&quot;},&quot;originalLabel&quot;:&quot;[S4]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S5&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S5&quot;,&quot;canonicalId&quot;:&quot;40107c2c-646d-7872-050b-107a4a66b1e9&quot;,&quot;openAlexWorkId&quot;:&quot;W2992858501&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W2992858501&quot;,&quot;title&quot;:&quot;Revealing the Relationship between Smartphone Addiction and Academic Performance of Students: Evidences from Higher Educational Institutes of Pakistan&quot;,&quot;url&quot;:&quot;https://openalex.org/W2992858501&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Arooba Azam Khan, Asma Khalid, Rimsha Iqbal&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Khan&quot;,&quot;given&quot;:&quot;Arooba Azam&quot;,&quot;name&quot;:&quot;Arooba Azam Khan&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Khalid&quot;,&quot;given&quot;:&quot;Asma&quot;,&quot;name&quot;:&quot;Asma Khalid&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-3919-2487&quot;,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Iqbal&quot;,&quot;given&quot;:&quot;Rimsha&quot;,&quot;name&quot;:&quot;Rimsha Iqbal&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-4685-2834&quot;,&quot;affiliations&quot;:[]}],&quot;year&quot;:2019,&quot;venue&quot;:&quot;Social Science Open Access Repository (GESIS – Leibniz Institute for the Social Sciences)&quot;,&quot;volume&quot;:&quot;3&quot;,&quot;issue&quot;:&quot;2&quot;,&quot;pages&quot;:&quot;74-83&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;GESIS - Leibniz Institute for the Social Sciences&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S5&quot;},&quot;originalLabel&quot;:&quot;[S5]&quot;}]" data-narrative="false">(Khan, Khalid and Iqbal, 2019; Tauheed et al., 2025; Chaudhary, 2026)</cite>, a comprehensive and detailed exploration of its specific moderating or mediating pathways within the social media-academic performance relationship is not fully established across a broad spectrum of evidence. Most quantitative research in this area also employs cross-sectional designs, which prevents the inference of causal relationships between variables <cite data-citation-id="" data-occurrence-id="2279400d-e418-4d30-ae79-c523695c7e68" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S11&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S11&quot;,&quot;canonicalId&quot;:&quot;2490620b-0319-3d39-1157-60d154812034&quot;,&quot;openAlexWorkId&quot;:&quot;W2994935786&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W2994935786&quot;,&quot;title&quot;:&quot;Social media and student performance: the moderating role of ICT knowledge&quot;,&quot;url&quot;:&quot;https://doi.org/10.1108/jices-08-2019-0092&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.1108/jices-08-2019-0092&quot;,&quot;authors&quot;:&quot;Robert Kwame Dzogbenuku, George Kofi Amoako, Desmond Kwadjo Kumi&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Dzogbenuku&quot;,&quot;given&quot;:&quot;Robert Kwame&quot;,&quot;name&quot;:&quot;Robert Kwame Dzogbenuku&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-6290-8458&quot;,&quot;affiliations&quot;:[&quot;Central University&quot;]},{&quot;family&quot;:&quot;Amoako&quot;,&quot;given&quot;:&quot;George Kofi&quot;,&quot;name&quot;:&quot;George Kofi Amoako&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-7966-4867&quot;,&quot;affiliations&quot;:[&quot;Central University&quot;]},{&quot;family&quot;:&quot;Kumi&quot;,&quot;given&quot;:&quot;Desmond Kwadjo&quot;,&quot;name&quot;:&quot;Desmond Kwadjo Kumi&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-5737-4965&quot;,&quot;affiliations&quot;:[]}],&quot;year&quot;:2019,&quot;venue&quot;:&quot;Journal of Information Communication and Ethics in Society&quot;,&quot;volume&quot;:&quot;18&quot;,&quot;issue&quot;:&quot;2&quot;,&quot;pages&quot;:&quot;197-219&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Emerald Publishing Limited&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S11&quot;},&quot;originalLabel&quot;:&quot;[S11]&quot;}]" data-narrative="false">(Dzogbenuku, Amoako and Kumi, 2019)</cite>. Future research could benefit from longitudinal designs to better understand the temporal dynamics and causal influences among these factors <cite data-citation-id="" data-occurrence-id="99f8f099-5aa3-486a-9deb-6802e6e01a06" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S11&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S11&quot;,&quot;canonicalId&quot;:&quot;2490620b-0319-3d39-1157-60d154812034&quot;,&quot;openAlexWorkId&quot;:&quot;W2994935786&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W2994935786&quot;,&quot;title&quot;:&quot;Social media and student performance: the moderating role of ICT knowledge&quot;,&quot;url&quot;:&quot;https://doi.org/10.1108/jices-08-2019-0092&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.1108/jices-08-2019-0092&quot;,&quot;authors&quot;:&quot;Robert Kwame Dzogbenuku, George Kofi Amoako, Desmond Kwadjo Kumi&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Dzogbenuku&quot;,&quot;given&quot;:&quot;Robert Kwame&quot;,&quot;name&quot;:&quot;Robert Kwame Dzogbenuku&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-6290-8458&quot;,&quot;affiliations&quot;:[&quot;Central University&quot;]},{&quot;family&quot;:&quot;Amoako&quot;,&quot;given&quot;:&quot;George Kofi&quot;,&quot;name&quot;:&quot;George Kofi Amoako&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-7966-4867&quot;,&quot;affiliations&quot;:[&quot;Central University&quot;]},{&quot;family&quot;:&quot;Kumi&quot;,&quot;given&quot;:&quot;Desmond Kwadjo&quot;,&quot;name&quot;:&quot;Desmond Kwadjo Kumi&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-5737-4965&quot;,&quot;affiliations&quot;:[]}],&quot;year&quot;:2019,&quot;venue&quot;:&quot;Journal of Information Communication and Ethics in Society&quot;,&quot;volume&quot;:&quot;18&quot;,&quot;issue&quot;:&quot;2&quot;,&quot;pages&quot;:&quot;197-219&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Emerald Publishing Limited&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S11&quot;},&quot;originalLabel&quot;:&quot;[S11]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S21&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S21&quot;,&quot;canonicalId&quot;:&quot;80252e99-0e17-4e15-221e-bb587113941d&quot;,&quot;openAlexWorkId&quot;:&quot;W7203538716&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7203538716&quot;,&quot;title&quot;:&quot;Beyond the Screen: How Peer-to-Peer and Lecturer Interactions Drive Collaborative Engagement and Academic Success&quot;,&quot;url&quot;:&quot;https://scrrjournal.com/index.php/14/article/download/798/990&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.5281/zenodo.21953385&quot;,&quot;authors&quot;:&quot;Hafiz Muhammad Humza, Mir Ahmad Feroz, Farah Siddique, Muhammad Qasim Ali&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Humza&quot;,&quot;given&quot;:&quot;Hafiz Muhammad&quot;,&quot;name&quot;:&quot;Hafiz Muhammad Humza&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0009-0009-8198-7989&quot;,&quot;affiliations&quot;:[&quot;University of Sialkot&quot;]},{&quot;family&quot;:&quot;Feroz&quot;,&quot;given&quot;:&quot;Mir Ahmad&quot;,&quot;name&quot;:&quot;Mir Ahmad Feroz&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Sialkot&quot;]},{&quot;family&quot;:&quot;Siddique&quot;,&quot;given&quot;:&quot;Farah&quot;,&quot;name&quot;:&quot;Farah Siddique&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Sialkot&quot;]},{&quot;family&quot;:&quot;Ali&quot;,&quot;given&quot;:&quot;Muhammad Qasim&quot;,&quot;name&quot;:&quot;Muhammad Qasim Ali&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Sialkot&quot;]}],&quot;year&quot;:2026,&quot;venue&quot;:&quot;Sociology &amp; Cultural Research Review&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S21&quot;},&quot;originalLabel&quot;:&quot;[S21]&quot;}]" data-narrative="false">(Dzogbenuku, Amoako and Kumi, 2019; Humza et al., 2026)</cite>. Additionally, studies often concentrate on specific social media platforms or narrow aspects such as social media addiction <cite data-citation-id="" data-occurrence-id="51f56262-d6b0-460e-9669-66fa7a5f2eb6" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S9&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S9&quot;,&quot;canonicalId&quot;:&quot;10cf1867-0020-fae6-1342-ab8dce07fad9&quot;,&quot;openAlexWorkId&quot;:&quot;W4411204892&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W4411204892&quot;,&quot;title&quot;:&quot;Social Media Addiction and Academic Performance of University Students&quot;,&quot;url&quot;:&quot;http://uijournal.usim.edu.my/index.php/uij/article/download/476/305&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.33102/uij.vol34no2.476&quot;,&quot;authors&quot;:&quot;Fatin Najihah Basri, Farhana Sabri, Mohd Khairul Anuar Rahimi&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Basri&quot;,&quot;given&quot;:&quot;Fatin Najihah&quot;,&quot;name&quot;:&quot;Fatin Najihah Basri&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Universiti Sains Islam Malaysia&quot;]},{&quot;family&quot;:&quot;Sabri&quot;,&quot;given&quot;:&quot;Farhana&quot;,&quot;name&quot;:&quot;Farhana Sabri&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-3177-3084&quot;,&quot;affiliations&quot;:[&quot;Universiti Sains Islam Malaysia&quot;]},{&quot;family&quot;:&quot;Rahimi&quot;,&quot;given&quot;:&quot;Mohd Khairul Anuar&quot;,&quot;name&quot;:&quot;Mohd Khairul Anuar Rahimi&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Universiti Sains Islam Malaysia&quot;]}],&quot;year&quot;:2022,&quot;venue&quot;:&quot;Ulum Islamiyyah&quot;,&quot;volume&quot;:&quot;34&quot;,&quot;issue&quot;:&quot;2&quot;,&quot;pages&quot;:&quot;1-17&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Universiti Sains Islam Malaysia&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S9&quot;},&quot;originalLabel&quot;:&quot;[S9]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S15&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S15&quot;,&quot;canonicalId&quot;:&quot;709df0c1-a94e-2623-9c06-ec42b7fd7158&quot;,&quot;openAlexWorkId&quot;:&quot;W7117361642&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7117361642&quot;,&quot;title&quot;:&quot;Excessive social media use and its impact on psychological well-being and academic performance of Vietnamese university students&quot;,&quot;url&quot;:&quot;https://doi.org/10.1080/02673843.2025.2608766&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.1080/02673843.2025.2608766&quot;,&quot;authors&quot;:&quot;Tran Minh Duc&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Duc&quot;,&quot;given&quot;:&quot;Tran Minh&quot;,&quot;name&quot;:&quot;Tran Minh Duc&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Thu Dau Mot University&quot;]}],&quot;year&quot;:2025,&quot;venue&quot;:&quot;International Journal of Adolescence and Youth&quot;,&quot;volume&quot;:&quot;31&quot;,&quot;issue&quot;:&quot;1&quot;,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Taylor &amp; Francis&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S15&quot;},&quot;originalLabel&quot;:&quot;[S15]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S17&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S17&quot;,&quot;canonicalId&quot;:&quot;ee8ba2a6-8919-289d-c6c6-db153a2a7a3d&quot;,&quot;openAlexWorkId&quot;:&quot;W7112829116&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7112829116&quot;,&quot;title&quot;:&quot;The influence of TikTok on academic performance among university students at UiTM Alor Gajah, Melaka&quot;,&quot;url&quot;:&quot;https://ir.uitm.edu.my/id/eprint/123523/1/123523.pdf&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Mat Said, Siti Hajar, Ahmad Hisham, Widad Nasuha, Hussar, Adlyn Nazurah, Anuar, Nur Ellesya Balqis, Sarudin, Muhammad Faizi, Sah Allam, Siti Nurshahidah, Hassan, Mohd Sufiean&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Hajar&quot;,&quot;given&quot;:&quot;Siti Hajar&quot;,&quot;name&quot;:&quot;Mat Said, Siti Hajar&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Nasuha&quot;,&quot;given&quot;:&quot;Widad Nasuha&quot;,&quot;name&quot;:&quot;Ahmad Hisham, Widad Nasuha&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Hussar&quot;,&quot;given&quot;:&quot;Adlyn Nazurah&quot;,&quot;name&quot;:&quot;Hussar, Adlyn Nazurah&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Anuar&quot;,&quot;given&quot;:&quot;Nur Ellesya Balqis&quot;,&quot;name&quot;:&quot;Anuar, Nur Ellesya Balqis&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Sarudin&quot;,&quot;given&quot;:&quot;Muhammad Faizi&quot;,&quot;name&quot;:&quot;Sarudin, Muhammad Faizi&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Nurshahidah&quot;,&quot;given&quot;:&quot;Siti Nurshahidah&quot;,&quot;name&quot;:&quot;Sah Allam, Siti Nurshahidah&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Hassan&quot;,&quot;given&quot;:&quot;Mohd Sufiean&quot;,&quot;name&quot;:&quot;Hassan, Mohd Sufiean&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]}],&quot;year&quot;:2025,&quot;venue&quot;:&quot;UiTM Institutional Repositories (Universiti Teknologi MARA)&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Universiti Teknologi MARA&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S17&quot;},&quot;originalLabel&quot;:&quot;[S17]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S20&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S20&quot;,&quot;canonicalId&quot;:&quot;72052be1-1693-9573-3fc3-1b3516addd04&quot;,&quot;openAlexWorkId&quot;:&quot;W2800281014&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W2800281014&quot;,&quot;title&quot;:&quot;SOCIAL MEDIA ADDICTION AND ACADEMIC ENGAGEMENT AMONG UNDERGRADUATE STUDENTS OF USMANU DANFODIYO UNIVERSITY SOKOTO, NIGERIA&quot;,&quot;url&quot;:&quot;https://ijitie.aitie.org.ng/index.php/ijitie/article/download/55/30&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Zubairu Suleiman&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Suleiman&quot;,&quot;given&quot;:&quot;Zubairu&quot;,&quot;name&quot;:&quot;Zubairu Suleiman&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Gombe State University&quot;]}],&quot;year&quot;:2017,&quot;venue&quot;:&quot;International Journal of Innovative Technology Integration in Education&quot;,&quot;volume&quot;:&quot;1&quot;,&quot;issue&quot;:&quot;2&quot;,&quot;pages&quot;:&quot;39-46&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S20&quot;},&quot;originalLabel&quot;:&quot;[S20]&quot;}]" data-narrative="false">(Suleiman, 2017; Basri, Sabri and Rahimi, 2022; Duc, 2025; Hajar et al., 2025)</cite>, rather than offering a holistic view of the interplay between diverse usage patterns, time management strategies, and academic outcomes.</p><h2>Conclusion</h2><p>This synthesis of existing literature establishes a multifaceted relationship between social media use, time management, and academic performance among university students. Characterized by diverse engagement patterns, social media can either hinder or enhance academic outcomes, largely depending on the purpose and extent of use. Non-academic and excessive social media engagement is consistently linked to poor time management, reduced concentration, and lower academic achievement. Conversely, purposeful, academic-oriented social media use can positively influence learning through collaborative engagement and information sharing.</p><p>The literature review highlights a crucial role for time management skills and digital self-discipline in moderating these impacts. While self-reported data limitations and a geographical imbalance in existing studies present challenges, the overall evidence underscores that the influence of social media is not inherent to the platforms themselves but rather to students' usage patterns. Future research could benefit from longitudinal designs to explore causal relationships more definitively and from expanded geographical representation to enhance generalizability.</p><h2>References</h2><div data-citation-reference="{&quot;sourceId&quot;:&quot;S7&quot;,&quot;canonicalId&quot;:&quot;8fb42fd7-cbdd-db81-7b9b-ca7b33d000fb&quot;,&quot;openAlexWorkId&quot;:&quot;W7215165637&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7215165637&quot;,&quot;title&quot;:&quot;INFLUENCE OF SOCIAL MEDIA PLATFORM USE ON ACADEMIC PERFORMANCE OF COOPERATIVE ECONOMICS AND MANAGEMENT STUDENTS AT NNAMDI AZIKIWE UNIVERSITY, AWKA&quot;,&quot;url&quot;:&quot;https://ijmsspcs.com/index.php/IJMSSPCS/article/download/870/943&quot;,&quot;source&quot;:&quot;web&quot;,&quot;documentId&quot;:null,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Lovelyn Chinwendu Ajubiga, Obianuju Chekwube-Aziekwe, Chinyere Chigozie Akpunonu, Stephanie Chidiogo Akonu&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Ajubiga&quot;,&quot;given&quot;:&quot;Lovelyn Chinwendu&quot;,&quot;name&quot;:&quot;Lovelyn Chinwendu Ajubiga&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Chekwube-Aziekwe&quot;,&quot;given&quot;:&quot;Obianuju&quot;,&quot;name&quot;:&quot;Obianuju Chekwube-Aziekwe&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Akpunonu&quot;,&quot;given&quot;:&quot;Chinyere Chigozie&quot;,&quot;name&quot;:&quot;Chinyere Chigozie Akpunonu&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Akonu&quot;,&quot;given&quot;:&quot;Stephanie Chidiogo&quot;,&quot;name&quot;:&quot;Stephanie Chidiogo Akonu&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]}],&quot;year&quot;:2026,&quot;venue&quot;:&quot;INTERNATIONAL JOURNAL OF MANAGEMENT, SOCIAL SCIENCES, PEACE AND CONFLICT STUDIES&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S7&quot;}">Ajubiga, L.C., Chekwube-Aziekwe, O., Akpunonu, C.C. and Akonu, S.C. (2026) &#39;Influence of Social Media Platform Use on Academic Performance of Cooperative Economics and Management Students at Nnamdi Azikiwe University, Awka&#39;, International Journal of Management, Social Sciences, Peace and Conflict Studies. Available at: https://ijmsspcs.com/index.php/IJMSSPCS/article/download/870/943.</div><div data-citation-reference="{&quot;sourceId&quot;:&quot;S12&quot;,&quot;canonicalId&quot;:&quot;dee8c6be-1cc2-192c-6a2d-afcbb16c127b&quot;,&quot;openAlexWorkId&quot;:&quot;W1981702783&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W1981702783&quot;,&quot;title&quot;:&quot;The Improvement of Students’ Academic Performance by Using Social Media through Collaborative Learning in Malaysian Higher Education&quot;,&quot;url&quot;:&quot;https://ccsenet.org/journal/index.php/ass/article/download/35490/20138&quot;,&quot;source&quot;:&quot;web&quot;,&quot;documentId&quot;:null,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.5539/ass.v10n8p210&quot;,&quot;authors&quot;:&quot;Waleed Mugahed Al-Rahmi, Mohd Shahizan Othman, Mahdi Alhaji Musa&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Al-Rahmi&quot;,&quot;given&quot;:&quot;Waleed Mugahed&quot;,&quot;name&quot;:&quot;Waleed Mugahed Al-Rahmi&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-0980-7439&quot;,&quot;affiliations&quot;:[&quot;University of Technology Malaysia&quot;]},{&quot;family&quot;:&quot;Othman&quot;,&quot;given&quot;:&quot;Mohd Shahizan&quot;,&quot;name&quot;:&quot;Mohd Shahizan Othman&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-4261-1873&quot;,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Musa&quot;,&quot;given&quot;:&quot;Mahdi Alhaji&quot;,&quot;name&quot;:&quot;Mahdi Alhaji Musa&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Technology Malaysia&quot;]}],&quot;year&quot;:2014,&quot;venue&quot;:&quot;Asian Social Science&quot;,&quot;volume&quot;:&quot;10&quot;,&quot;issue&quot;:&quot;8&quot;,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;Canadian Center of Science and Education&quot;,&quot;language&quot;:&quot;en&quot;