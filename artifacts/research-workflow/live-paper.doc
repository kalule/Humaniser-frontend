;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Zubairu Suleiman&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Suleiman&quot;,&quot;given&quot;:&quot;Zubairu&quot;,&quot;name&quot;:&quot;Zubairu Suleiman&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Gombe State University&quot;]}],&quot;year&quot;:2017,&quot;venue&quot;:&quot;International Journal of Innovative Technology Integration in Education&quot;,&quot;volume&quot;:&quot;1&quot;,&quot;issue&quot;:&quot;2&quot;,&quot;pages&quot;:&quot;39-46&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S20&quot;},&quot;originalLabel&quot;:&quot;[S20]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S22&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S22&quot;,&quot;canonicalId&quot;:&quot;b7f8d5e6-4813-3198-4099-2f6203e3cbc8&quot;,&quot;openAlexWorkId&quot;:&quot;W7214813884&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7214813884&quot;,&quot;title&quot;:&quot;SOCIAL NETWORKING USAGE AND ACADEMIC PERFORMANCE OF SCHOOL-GOING ADOLESCENTS IN OYO CITY, NIGERIA&quot;,&quot;url&quot;:&quot;https://tijseg.org/index.php/tijseg/article/download/109/146&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Fatimah Wuraola Garba&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Garba&quot;,&quot;given&quot;:&quot;Fatimah Wuraola&quot;,&quot;name&quot;:&quot;Fatimah Wuraola Garba&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Abuja&quot;]}],&quot;year&quot;:2022,&quot;venue&quot;:&quot;Turkish International Journal of Special Education and Guidance &amp; Counselling (TIJSEG)&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S22&quot;},&quot;originalLabel&quot;:&quot;[S22]&quot;}]" data-narrative="false">(Suleiman, 2017; Khan, Khalid and Iqbal, 2019; Chathuranga and Jaysundara, 2020; Garba, 2022; Ciroma, Abubakar and Bashir, 2025; Duc, 2025; Hajar et al., 2025; Sadia, Babar and Ghaffar, 2025; Sari et al., 2025; Ajubiga et al., 2026; Ara and Santosa, 2026; Chaudhary, 2026; OMI UJUANBI and Omolegho, 2026; European Journal of Integrative Medicinal and Allied Paramedical Spectrum Studies, 2026)</cite>. For instance, a moderate negative correlation between social media usage and academic performance has been observed among undergraduate students, with younger and lower-level students being particularly susceptible to negative outcomes <cite data-citation-id="" data-occurrence-id="c1c341f9-27f5-48aa-ba2f-0b3dfc038443" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S2&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S2&quot;,&quot;canonicalId&quot;:&quot;28ce1149-4303-2730-e196-a95a7770bb92&quot;,&quot;openAlexWorkId&quot;:&quot;W7160121679&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7160121679&quot;,&quot;title&quot;:&quot;EFFECTS OF SOCIAL MEDIA ON SCHOOL PERFORMANCE: AN INVESTIGATIVE STUDY OF UNDERGRADUATE STUDENTS IN EDO STATE&quot;,&quot;url&quot;:&quot;https://doi.org/10.54922/ijehss.2026.1251&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.54922/ijehss.2026.1251&quot;,&quot;authors&quot;:&quot;OMI UJUANBI, Gloria Omolegho&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;OMI UJUANBI&quot;,&quot;given&quot;:null,&quot;name&quot;:&quot;OMI UJUANBI&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Ambrose Alli University&quot;]},{&quot;family&quot;:&quot;Omolegho&quot;,&quot;given&quot;:&quot;Gloria&quot;,&quot;name&quot;:&quot;Gloria Omolegho&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Ambrose Alli University&quot;]}],&quot;year&quot;:2026,&quot;venue&quot;:&quot;International Journal of Education Humanities and Social Science&quot;,&quot;volume&quot;:&quot;09&quot;,&quot;issue&quot;:&quot;02&quot;,&quot;pages&quot;:&quot;398-410&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S2&quot;},&quot;originalLabel&quot;:&quot;[S2]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S5&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S5&quot;,&quot;canonicalId&quot;:&quot;40107c2c-646d-7872-050b-107a4a66b1e9&quot;,&quot;openAlexWorkId&quot;:&quot;W2992858501&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W2992858501&quot;,&quot;title&quot;:&quot;Revealing the Relationship between Smartphone Addiction and Academic Performance of Students: Evidences from Higher Educational Institutes of Pakistan&quot;,&quot;url&quot;:&quot;https://openalex.org/W2992858501&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Arooba Azam Khan, Asma Khalid, Rimsha Iqbal&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Khan&quot;,&quot;given&quot;:&quot;Arooba Azam&quot;,&quot;name&quot;:&quot;Arooba Azam Khan&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Khalid&quot;,&quot;given&quot;:&quot;Asma&quot;,&quot;name&quot;:&quot;Asma Khalid&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-3919-2487&quot;,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quo