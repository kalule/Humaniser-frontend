//scrrjournal.com/index.php/14/article/download/798/990&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.5281/zenodo.21953385&quot;,&quot;authors&quot;:&quot;Hafiz Muhammad Humza, Mir Ahmad Feroz, Farah Siddique, Muhammad Qasim Ali&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Humza&quot;,&quot;given&quot;:&quot;Hafiz Muhammad&quot;,&quot;name&quot;:&quot;Hafiz Muhammad Humza&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0009-0009-8198-7989&quot;,&quot;affiliations&quot;:[&quot;University of Sialkot&quot;]},{&quot;family&quot;:&quot;Feroz&quot;,&quot;given&quot;:&quot;Mir Ahmad&quot;,&quot;name&quot;:&quot;Mir Ahmad Feroz&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Sialkot&quot;]},{&quot;family&quot;:&quot;Siddique&quot;,&quot;given&quot;:&quot;Farah&quot;,&quot;name&quot;:&quot;Farah Siddique&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Sialkot&quot;]},{&quot;family&quot;:&quot;Ali&quot;,&quot;given&quot;:&quot;Muhammad Qasim&quot;,&quot;name&quot;:&quot;Muhammad Qasim Ali&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Sialkot&quot;]}],&quot;year&quot;:2026,&quot;venue&quot;:&quot;Sociology &amp; Cultural Research Review&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S21&quot;},&quot;originalLabel&quot;:&quot;[S21]&quot;}]" data-narrative="false">(Al-Rahmi, Othman and Musa, 2014; Chathuranga and Jaysundara, 2020; Ciroma, Abubakar and Bashir, 2025; Tauheed et al., 2025; Ajubiga et al., 2026; Chaudhary, 2026; Humza et al., 2026; OMI UJUANBI and Omolegho, 2026)</cite>, a significant proportion of students admit to using them primarily for non-academic reasons <cite data-citation-id="" data-occurrence-id="228ccc5a-f9d1-4fdc-ac48-704457de6489" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S13&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S13&quot;,&quot;canonicalId&quot;:&quot;35af1ecd-c552-446e-9486-334fa2d31122&quot;,&quot;openAlexWorkId&quot;:&quot;W4414553366&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W4414553366&quot;,&quot;title&quot;:&quot;Patterns, Perceptions, and Academic Implications of Social Media Use among Tertiary Institution Students in Yobe State, Nigeria&quot;,&quot;url&quot;:&quot;https://ejournal.yasin-alsys.org/AMJSAI/article/download/7482/5600&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.58578/amjsai.v2i3.7482&quot;,&quot;authors&quot;:&quot;Zainab Ibrahim Ciroma, Abdulkadir Musa Abubakar, Abdulkarim Bello Bashir&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Ciroma&quot;,&quot;given&quot;:&quot;Zainab Ibrahim&quot;,&quot;name&quot;:&quot;Zainab Ibrahim Ciroma&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Abubakar&quot;,&quot;given&quot;:&quot;Abdulkadir Musa&quot;,&quot;name&quot;:&quot;Abdulkadir Musa Abubakar&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Federal Polytechnic Damaturu&quot;]},{&quot;family&quot;:&quot;Bashir&quot;,&quot;given&quot;:&quot;Abdulkarim Bello&quot;,&quot;name&quot;:&quot;Abdulkarim Bello Bashir&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-0577-5801&quot;,&quot;affiliations&quot;:[]}],&quot;year&quot;:2025,&quot;venue&quot;:&quot;African Multidisciplinary Journal of Sciences and Artificial Intelligence&quot;,&quot;volume&quot;:&quot;2&quot;,&quot;issue&quot;:&quot;3&quot;,&quot;pages&quot;:&quot;508-520&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S13&quot;},&quot;originalLabel&quot;:&quot;[S13]&quot;}]" data-narrative="false">(Ciroma, Abubakar and Bashir, 2025)</cite>. Studies also suggest that younger and lower-level students may be more susceptible to negative outcomes associated with social media use <cite data-citation-id="" data-occurrence-id="32525a8c-5482-4c14-acdf-a69ab44833ab" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S2&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S2&quot;,&quot;canonicalId&quot;:&quot;28ce1149-4303-2730-e196-a95a7770bb92&quot;,&quot;openAlexWorkId&quot;:&quot;W7160121679&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7160121679&quot;,&quot;title&quot;:&quot;EFFECTS OF SOCIAL MEDIA ON SCHOOL PERFORMANCE: AN INVESTIGATIVE STUDY OF UNDERGRADUATE STUDENTS IN EDO STATE&quot;,&quot;url&quot;:&quot;https://doi.org/10.54922/ijehss.2026.1251&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.54922/ijehss.2026.1251&quot;,&quot;authors&quot;:&quot;OMI UJUANBI, Gloria Omolegho&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;OMI UJUANBI&quot;,&quot;given&quot;:null,&quot;name&quot;:&quot;OMI UJUANBI&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Ambrose Alli University&quot;]},{&quot;family&quot;:&quot;Omolegho&quot;,&quot;given&quot;:&quot;Gloria&quot;,&quot;name&quot;:&quot;Gloria Omolegho&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;Ambrose Alli University&quot;]}],&quot;year&quot;:2026,&quot;venue&quot;:&quot;International Journal of Education Humanities and Social Science&quot;,&quot;volume&quot;:&quot;09&quot;,&quot;issue&quot;:&quot;02&quot;,&quot;pages&quot;:&quot;398-410&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S2&quot;},&quot;originalLabel&quot;:&quot;[S2]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S5&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S5&quot;,&quot;canonicalId&quot;:&quot;40107c2c-646d-7872-050b-107a4a66b1e9&quot;,&quot;openAlexWorkId&quot;:&quot;W2992858501&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W2992858501&quot;,&quot;title&quot;:&quot;Revealing the Relationship between Smartphone Addiction and Academic Performance of Students: Evidences from Higher Educational Institutes of Pakistan&quot;,&quot;url&quot;:&quot;https://openalex.org/W2992858501&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:null,&quot;authors&quot;:&quot;Arooba Azam Khan, Asma Khalid, Rimsha Iqbal&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Khan&quot;,&quot;given&quot;:&quot;Arooba Azam&quot;,&quot;name&quot;:&quot;Arooba Azam Khan&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Khalid&quot;,&quot;given&quot;:&quot;Asma&quot;,&quot;name&quot;:&quot;Asma Khalid&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-3919-2487&quot;,&quot;affiliations&quot;:[]},{&quot;family&quot;:&quot;Iqbal&quot;,&quot;given&quot;:&quot;Rimsha&quot;,&quot;name&quot;:&quot;Rimsha Iqbal&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0003-4685-2834&quot;,&quot;affiliations&quot;:[]}],&quot;year&quot;:2019,&quot;venue&quot;:&quot;Social Science Open Access Repository (GESIS – Leibniz Institute for the Social Sciences)&quot;,&quot;volume&quot;:&quot;3&quot;,&quot;issue&quot;:&quot;2&quot;,&quot;pages&quot;:&quot;74-83&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;GESIS - Leibniz Institute for the Social Sciences&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S5&quot;},&quot;originalLabel&quot;:&quot;[S5]&quot;}]" data-narrative="false">(Khan, Khalid and Iqbal, 2019; OMI UJUANBI and Omolegho, 2026)</cite>. The highest average time spent on social media is often for social purposes, followed by online gaming <cite data-citation-id="" data-occurrence-id="6e829a72-2799-4582-9197-f0a8190cb0df" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S10&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S10&quot;,&quot;canonicalId&quot;:&quot;df653c18-d4a9-d160-3265-f92776296c0a&quot;,&quot;openAlexWorkId&quot;:&quot;W4405879829&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W4405879829&quot;,&quot;title&quot;:&quot;Impact of social media on higher education: Academic performance, leadership and co-curricular activity engagement&quot;,&quot;url&quot;:&quot;https://malque.pub/ojs/index.php/mr/article/download/5665/3193&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.31893/multirev.2025142&quot;,&quot;authors&quot;:&quot;Al Amin Mohamed Sultan, Erwan Ismail, Mohd Shamsuri Md Saad, Afifuddin Husairi Hussain, Muhammad Zaid Daud, Haitham M. Alswat&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Sultan&quot;,&quot;given&quot;:&quot;Al Amin Mohamed&quot;,&quot;name&quot;:&quot;Al Amin Mohamed Sultan&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0001-7063-2706&quot;,&quot;affiliations&quot;:[&quot;Universiti Teknikal Malaysia Melaka&quot;]},{&quot;family&quot;:&quot;Ismail&quot;,&quot;given&quot;:&quot;Erwan&quot;,&quot;name&quot;:&quot;Erwan Ismail&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0009-0007-1706-1394&quot;,&quot;affiliations&quot;:[&quot;Universiti Teknikal Malaysia Melaka&quot;]},{&quot;family&quot;:&quot;Saad&quot;,&quot;given&quot;:&quot;Mohd Shamsuri Md&quot;,&quot;name&quot;:&quot;Mohd Shamsuri Md Saad&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-2269-5494&quot;,&quot;affiliations&quot;:[&quot;Universiti Teknikal Malaysia Melaka&quot;]},{&quot;family&quot;:&quot;Hussain&quot;,&quot;given&quot;:&quot;Afifuddin Husairi&quot;,&quot;name&quot;:&quot;Afifuddin Husairi Hussain&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0001-5447-9828&quot;,&quot;affiliations&quot;:[&quot;National University of Malaysia&quot;]},{&quot;family&quot;:&quot;Daud&quot;,&quot;given&quot;:&quot;Muhammad Zaid&quot;,&quot;name&quot;:&quot;Muhammad Zaid Daud&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0002-4394-5181&quot;,&quot;affiliations&quot;:[&quot;National University of Malaysia&quot;]},{&quot;family&quot;:&quot;Alswat&quot;,&quot;given&quot;:&quot;Haitham M.&quot;,&quot;name&quot;:&quot;Haitham M. Alswat&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0000-0001-5032-9259&quot;,&quot;affiliations&quot;:[&quot;Shaqra University&quot;]}],&quot;year&quot;:2024,&quot;venue&quot;:&quot;Multidisciplinary Reviews&quot;,&quot;volume&quot;:&quot;8&quot;,&quot;issue&quot;:&quot;5&quot;,&quot;pages&quot;:&quot;2025142&quot;,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S10&quot;},&quot;originalLabel&quot;:&quot;[S10]&quot;}]" data-narrative="false">(Sultan et al., 2024)</cite>. The pervasive nature of these platforms means that their influence on student life is a growing area of concern <cite data-citation-id="" data-occurrence-id="161fc9bb-fdd0-4e8a-af2b-fcb2f98c036e" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S4&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S4&quot;,&quot;canonicalId&quot;:&quot;4286b9f9-2462-9531-fc7d-9ff6094dcb6c&quot;,&quot;openAlexWorkId&quot;:&quot;W7164532107&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7164532107&quot;,&quot;title&quot;:&quot;The Influence of Social Media Usage on Students&#39; Academic Performance and Study Habits&quot;,&quot;url&quot;:&quot;https://doi.org/10.5281/zenodo.20669918&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.5281/zenodo.20669918&quot;,&quot;authors&quot;:&quot;Saroj Chaudhary&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Chaudhary&quot;,&quot;given&quot;:&quot;Saroj&quot;,&quot;name&quot;:&quot;Saroj Chaudhary&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[]}],&quot;year&quot;:2026,&quot;venue&quot;:&quot;Zenodo (CERN European Organization for Nuclear Research)&quot;,&quot;volume&quot;:null,&quot;issue&quot;:null,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:&quot;European Organization for Nuclear Research&quot;,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S4&quot;},&quot;originalLabel&quot;:&quot;[S4]&quot;}]" data-narrative="false">(Chaudhary, 2026)</cite>.</p><p>### Impact on Time Management<br>The literature consistently highlights a strong link between social media use and time management practices among university students. Excessive and non-academic social media engagement is frequently associated with poor time management, reduced study efficiency, and decreased concentration <cite data-citation-id="" data-occurrence-id="15871749-df12-4197-becb-d6639b015e08" data-items="[{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S1&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S1&quot;,&quot;canonicalId&quot;:&quot;50c0f715-5ed4-66e3-96d9-0b8fb9aa09d6&quot;,&quot;openAlexWorkId&quot;:&quot;W7168081275&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.org/W7168081275&quot;,&quot;title&quot;:&quot;Time Spent on Social Media and its Impact on Academic Performance: Evidence from University Students in Sargodha, Pakistan&quot;,&quot;url&quot;:&quot;https://ojs.pssr.org.pk/journal/article/download/1159/947&quot;,&quot;source&quot;:&quot;web&quot;,&quot;passageStart&quot;:null,&quot;passageEnd&quot;:null,&quot;doi&quot;:&quot;10.35484/pssr.2025(9-iv)22&quot;,&quot;authors&quot;:&quot;Halema Sadia, Muhammad Hassan Babar, Zunaira Ghaffar&quot;,&quot;authorDetails&quot;:[{&quot;family&quot;:&quot;Sadia&quot;,&quot;given&quot;:&quot;Halema&quot;,&quot;name&quot;:&quot;Halema Sadia&quot;,&quot;orcid&quot;:&quot;https://orcid.org/0009-0008-4477-3319&quot;,&quot;affiliations&quot;:[&quot;University of Sargodha&quot;]},{&quot;family&quot;:&quot;Babar&quot;,&quot;given&quot;:&quot;Muhammad Hassan&quot;,&quot;name&quot;:&quot;Muhammad Hassan Babar&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Lahore&quot;]},{&quot;family&quot;:&quot;Ghaffar&quot;,&quot;given&quot;:&quot;Zunaira&quot;,&quot;name&quot;:&quot;Zunaira Ghaffar&quot;,&quot;orcid&quot;:null,&quot;affiliations&quot;:[&quot;University of Sargodha&quot;]}],&quot;year&quot;:2025,&quot;venue&quot;:&quot;Pakistan Social Sciences Review&quot;,&quot;volume&quot;:&quot;9&quot;,&quot;issue&quot;:&quot;IV&quot;,&quot;pages&quot;:null,&quot;workType&quot;:&quot;article&quot;,&quot;publisher&quot;:null,&quot;language&quot;:&quot;en&quot;,&quot;yearLabel&quot;:null,&quot;id&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S1&quot;},&quot;originalLabel&quot;:&quot;[S1]&quot;},{&quot;sourceId&quot;:&quot;fb7822bf-c876-49f5-9489-213f495ab409:S2&quot;,&quot;source&quot;:{&quot;sourceId&quot;:&quot;S2&quot;,&quot;canonicalId&quot;:&quot;28ce1149-4303-2730-e196-a95a7770bb92&quot;,&quot;openAlexWorkId&quot;:&quot;W7160121679&quot;,&quot;pmid&quot;:null,&quot;provider&quot;:&quot;OpenAlex&quot;,&quot;providerRecordId&quot;:&quot;https://openalex.