VITE_API_URL=
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_key_here
VITE_APP_NAME=HumaniseAI
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Citation-check flags and flag counts are hidden (false = off for everyone, admins too); production leaves them unset (admins only).
VITE_SHOW_CITATION_FLAGS=false
VITE_SHOW_FLAG_COUNTS=false
VITE_SHOW_PROPOSAL_ISSUES=true
VITE_REVIEW_EXPORT_GATE=off
